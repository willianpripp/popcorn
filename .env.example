# Copy to .env before the first `docker compose up`. Compose reads it
# automatically and the file is git-ignored, so real values never leave the
# host. Every variable below has a working default (empty, meaning "that
# feature is off") except the database password, which is required on
# purpose.

# --- required --------------------------------------------------------------

# Password for the bundled Postgres container. Anything works for a local try;
# generate a real one for an instance anybody else can reach.
POP_DB_PASSWORD=change-me


# --- the login (optional) ---------------------------------------------------
# Leave both empty for a local or private-network run. Requests from loopback,
# RFC1918 addresses and Tailscale's range are trusted and never see a login
# screen; with these unset, anyone arriving from anywhere else is refused
# instead of prompted, which is the safe direction to fail.
#
# GATE_SECRET is the HMAC key for the session cookie: any long random string.
# GATE_USERS is a comma separated list of name=hash pairs. Mint a hash with
#   python app/gate.py 'the-password'
# and paste the whole pbkdf2:... string. Plain passwords never go in here.
# The household runs this app alongside groceries/the calendar and shares one
# GATE_SECRET/GATE_USERS across all of them (one login, one cookie); a
# standalone install of just this app can set its own values instead.
GATE_SECRET=
GATE_USERS=


# --- optional: TMDB (search, posters, runtimes, genres) ---------------------
# Without it, the search boxes on "Want to watch" and "Log something you
# watched" return nothing: titles can no longer be added, though anything
# already in the diary still displays fine. Get a key at
# https://www.themoviedb.org/settings/api. Either the v3 key or a v4 bearer
# token (starts with "eyJ") is accepted.
POP_TMDB_KEY=


# --- optional: Jellyfin (automatic diary + request arrivals) ----------------
# Without both of these, the Jellyfin sync job is skipped entirely (one clear
# line printed at startup) and requests never auto-flip to "available": the
# app is still fully usable, just manual. POP_JF_KEY is an API key generated
# in Jellyfin's dashboard (Advanced > API Keys).
POP_JF_URL=http://jellyfin.example.internal:8096
POP_JF_KEY=


# --- optional: calendar integration (attended events) -----------------------
# A companion calendar app's endpoints for Cinema visits and other attended
# events (concerts, sports, trips). Without these, that sync job is skipped
# and the diary only gets entries from Jellyfin and manual logging.
POP_CAL_API=
POP_CAL_API_WIDE=


# --- optional: Telegram (request-arrived pings) ------------------------------
# Without a token, arrivals still update on the "Want to watch" page, they
# just don't ping anyone's phone.
# POP_TELEGRAM_CHATS=willian=123456789,aline=987654321
POP_TELEGRAM_TOKEN=
POP_TELEGRAM_CHATS=


# --- optional ---------------------------------------------------------------

# Who is holding the phone, without asking anybody to log in. Comma separated
# substring=name pairs, matched against the caller's address, used only to
# label who requested or logged something.
#   POP_DEVICES=192.0.2.15=Willian,192.0.2.42=Aline
POP_DEVICES=

# Where the header's home icon points when this app is reached on its own port.
# Empty means there is no portal to go back to and the icon is not drawn. When
# the app is served under a path prefix (X-Forwarded-Prefix) the icon points at
# that host's root instead and this value is ignored.
POP_PORTAL_URL=

TZ=America/New_York
